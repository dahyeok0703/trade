# ─────────────────────────────────────────────────────────────────────────────
# Trade Docs — environment variables
# Copy this file to `.env.local` and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required) — from the Supabase dashboard / `supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI extraction (optional). If unset, AI-assisted features are disabled gracefully.
# Used ONLY to extract line items from order documents — never for judgement.
ANTHROPIC_API_KEY=

# Billing — PortOne(포트원) V2 (optional). If unset, billing is shown as "준비중"
# (disabled) and the rest of the app works normally.
# Public (browser): from the PortOne console → 상점/채널 설정.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# Server-only. API secret authorizes recurring billing-key payments — never expose.
PORTONE_API_SECRET=
# Server-only. Webhook signing secret (whsec_...) — verifies inbound webhooks.
PORTONE_WEBHOOK_SECRET=
